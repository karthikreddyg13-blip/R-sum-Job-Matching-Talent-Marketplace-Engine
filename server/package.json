{
  "name": "talentmatch-server",
  "version": "1.0.0",
  "description": "DSA-powered matching engine backend for Résumé–Job Matching & Talent Marketplace",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "npx tsx watch src/index.ts",
    "seed": "npx tsx src/seed.ts",
    "seed:supabase": "npx tsx src/supabase-seed.ts",
    "test": "npx tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.2",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^22.5.0",
    "c8": "^10.1.2",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4"
  }
}
