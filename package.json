{
  "name": "talentmatch",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "dev": "node scripts/dev.js",
    "build": "npm run build --workspace=talentmatch-server && npm run build --workspace=talentmatch-web",
    "test": "npm test --workspace=talentmatch-server",
    "lint": "npm run lint --workspace=talentmatch-web",
    "seed": "npm run seed --workspace=talentmatch-server",
    "seed:supabase": "npm run seed:supabase --workspace=talentmatch-server"
  }
}